generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for the Vercel Node runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NOTE: enum-like columns are stored as plain strings, validated in
// src/lib/validation.ts; `Vehicle.features` / `Vehicle.images` are JSON string
// arrays (see src/lib/features.ts). String union types live in
// src/lib/constants.ts. This modelling came from the original SQLite schema
// and is kept unchanged on PostgreSQL for stability.
// ---------------------------------------------------------------------------

// Enquiries / leads captured from the public booking widget, contact form and
// tour package enquiry form — one shared table/admin screen for every lead.
model Enquiry {
  id             String   @id @default(cuid())
  name           String
  phone          String
  serviceType    String // ONE_WAY | ROUND_TRIP | AIRPORT | LOCAL | TOUR_PACKAGE
  pickupLocation String
  dropLocation   String?
  pickupAt       DateTime?
  message        String?
  status         String   @default("NEW") // NEW | CONTACTED | BOOKED | CLOSED
  adminNotes     String?
  sourcePage     String   @default("home")

  // Populated only for tour-package enquiries (serviceType = TOUR_PACKAGE).
  packageSlug        String?
  packageTitle       String?
  travellers         Int?
  vehiclePreference  String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Fleet
model Vehicle {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique @default("")
  category  String // CAR | TEMPO_TRAVELLER | BUS
  seats     String // e.g. "4+1", "12+1", "30-45"
  features  String  @default("[]") // JSON string array
  imageUrl  String // cover image
  images    String  @default("[]") // JSON string array of extra gallery images
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // When true, rates are hidden and a "Contact for quote" CTA is shown instead.
  quoteOnRequest Boolean @default(false)

  oneWayRate Int?
  oneWayNote String?

  roundTripPerKm Int?
  minKmPerDay    Int?
  driverBata     Int?
  roundTripNote  String?

  localPackageRate Int?
  localExtraPerKm  Int?
  localExtraPerHr  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
}

// Destinations
model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String // HILL_STATION | HERITAGE | PILGRIMAGE | NATURE_FALLS | MAJOR_CITY | OUTSTATION_GETAWAY
  state       String   @default("KARNATAKA")
  description String
  imageUrl    String
  distanceKm  Int?
  highlights  String   @default("[]")
  // Optional slug of a matching TourPackage — cross-links the cab-route page
  // to a multi-day package for the same place, when one exists.
  packageSlug String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([state, isActive])
}

// Testimonials
model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  location   String
  rating     Int      @default(5)
  quote      String
  imageUrl   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}

// FAQ
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// Site settings (single row, id = "singleton")
model SiteSettings {
  id String @id @default("singleton")

  heroHeadline    String
  heroSubheadline String
  heroImageUrl    String

  aboutStory   String
  aboutPromise String

  trustYears  String
  trustTrips  String
  trustCities String

  ctaBannerText String

  phone          String
  whatsappNumber String
  email          String
  address        String
  hours          String
  mapEmbedUrl    String

  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?

  adminId           String  @default("admin")
  adminPasswordHash String?

  updatedAt DateTime @updatedAt
}

// Tours & Packages — Bangalore-origin South India tour packages. All list-type
// fields (gallery/itinerary/inclusions/exclusions/vehicleOptions/
// pickupLocations/tags/faq) are JSON strings, decoded in src/lib/packages.ts,
// matching the Vehicle.features convention above.
model TourPackage {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  origin      String @default("Bangalore")
  destination String // e.g. "Coorg"
  route       String // e.g. "Bangalore → Coorg"
  state       String // KARNATAKA | KERALA | TAMIL_NADU | ANDHRA_PRADESH | TELANGANA | GOA | PUDUCHERRY
  region      String @default("SOUTH_INDIA")
  category    String @default("[]") // JSON array of PackageCategory codes

  durationDays   Int
  durationNights Int
  distanceKm     Int?
  startingPrice  Int?
  priceType      String @default("PER_PACKAGE") // PER_PACKAGE | PER_PERSON

  shortDescription String
  description      String
  featuredImage    String
  gallery          String @default("[]")

  itinerary       String @default("[]") // [{day,title,description}]
  inclusions      String @default("[]")
  exclusions      String @default("[]")
  vehicleOptions  String @default("[]")
  pickupLocations String @default("[]")
  tags            String @default("[]") // used as "highlights"
  faq             String @default("[]") // [{question,answer}]

  featured  Boolean @default(false)
  popular   Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, isActive])
  @@index([featured])
  @@index([popular])
  @@index([sortOrder])
}
