# ---------------------------------------------------------------------------
# Sumpreeth Tours and Travels - environment variables
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local: run `docker run --name sumpreeth-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16`
#   then use: postgresql://postgres:postgres@localhost:5432/sumpreeth
# Production: create a free database at https://neon.tech and paste its pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sumpreeth?schema=public"

# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string"

# bcrypt hash of the admin portal password. Generate with:
#   npm run seed        (prints a hash for the default password), or
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "YourPasswordHere"
# The default password produced by the seed script is: sumpreeth@admin
ADMIN_PASSWORD_HASH="$2a$10$replace-with-a-real-bcrypt-hash"

# Public site URL (no trailing slash). Used for canonical tags, sitemap, OpenGraph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Canonical hostname (no scheme). In production the middleware 308-redirects
# any other host — and plain http — to https://<this host>. Leave blank to skip
# host canonicalisation (HTTPS upgrade still applies). Example: sumpreethtoursandtravels.com
NEXT_PUBLIC_CANONICAL_HOST=""

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable
# analytics entirely (no script loads). When set, GA4 loads for all visitors
# with IP anonymisation and no advertising features.
NEXT_PUBLIC_GA_ID=""

# Google Ads conversion tag (e.g. AW-11277138143). Leave blank to disable.
# Shares the same gtag.js loader as GA4 above.
NEXT_PUBLIC_ADS_ID=""

# Shared secret for POST /api/revalidate (purges the public data-cache tags).
REVALIDATE_SECRET=""

# Google Search Console verification token (the value from the "HTML tag"
# verification method, without the surrounding <meta> markup). Optional.
NEXT_PUBLIC_GSC_VERIFICATION=""

# Optional: admin login ID when the database row doesn't set one (default "admin").
ADMIN_ID="admin"
